# Local development only. No credentials are required for the initial skeleton.
# The farm view contains no data and is disabled by default.
NUXT_PUBLIC_FLAGS_FARM_VIEW=false
# Login is opt-in. Supply independent secrets outside version control.
# Requires migrations 0001..0005, a dedicated database and HTTPS even locally.
NUXT_AUTH_ENABLED=false
NUXT_AUTH_ORIGIN=
NUXT_AUTH_SESSION_SECRET=
NUXT_AUTH_DATABASE_URL=

# Optional overrides for isolated simulators (loopback HTTP origins only).
SIM_SV06_URL=http://127.0.0.1:7125
SIM_U1_URL=http://127.0.0.1:7126
SIM_SPOOLMAN_URL=http://127.0.0.1:7912
SIM_CAMERA_URL=http://127.0.0.1:8112
SIM_CAMERA_HOST=127.0.0.1
SIM_CAMERA_PORT=8112

# Pairing/recovery is opt-in and requires auth, inventory and migrations 0001..0012.
# Use separate dedicated restricted logins granted ONLY the matching existing roles:
# farm_pairing_runtime, farm_pairing_proof_runtime, farm_connector_revoker.
# No schema owner/superuser credentials. Keep all values outside version control.
NUXT_CONNECTOR_PAIRING_ENABLED=false
NUXT_CONNECTOR_PAIRING_ORIGIN=
NUXT_CONNECTOR_PAIRING_DATABASE_URL=
NUXT_CONNECTOR_PAIRING_PROOF_DATABASE_URL=
NUXT_CONNECTOR_PAIRING_REVOCATION_DATABASE_URL=
NUXT_CONNECTOR_PAIRING_AUDIENCE=
NUXT_CONNECTOR_PAIRING_ISSUER=
NUXT_CONNECTOR_PAIRING_SIGNING_KEY_ID=
# Absolute owner-private regular PKCS8 Ed25519 file, no symlinks, mode 0600/0400.
# Provision the key outside this repository. Never generate keys during server startup.
NUXT_CONNECTOR_PAIRING_SIGNING_KEY_PATH=
# Explicit integer 1..3600 seconds. No automatic renewal or offline authorization grant.
NUXT_CONNECTOR_PAIRING_TOKEN_TTL_SECONDS=
# Rotation: replace private file/key ID via secure provisioning and restart the runtime.
# Consumers must retain old public verification keys through issued token expiry and
# check current enrollment/revocation plus fresh possession proof. JWT alone grants no commands.

# Browser-device enrollment is opt-in and requires auth and the real migration history through 0013.
# Use a dedicated restricted login granted only farm_browser_device_runtime.
# Keep the independent database connection outside version control.
NUXT_BROWSER_DEVICES_ENABLED=false
NUXT_BROWSER_DEVICES_DATABASE_URL=
