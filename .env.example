# Local development only. No credentials are required for the initial skeleton.
# The farm view contains no data and is disabled by default.
NUXT_PUBLIC_FLAGS_FARM_VIEW=false
# Login is opt-in. Supply independent secrets outside version control.
# Requires migrations 0001..0005, a dedicated database and HTTPS even locally.
NUXT_AUTH_ENABLED=false
NUXT_AUTH_ORIGIN=
NUXT_AUTH_SESSION_SECRET=
NUXT_AUTH_DATABASE_URL=

# Optional overrides for isolated simulators (loopback HTTP origins only).
SIM_SV06_URL=http://127.0.0.1:7125
SIM_U1_URL=http://127.0.0.1:7126
SIM_SPOOLMAN_URL=http://127.0.0.1:7912
SIM_CAMERA_URL=http://127.0.0.1:8112
SIM_CAMERA_HOST=127.0.0.1
SIM_CAMERA_PORT=8112
