{
  "name": "open3dfarmmanager",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/farm dev",
    "build": "pnpm --dir packages/connector build && pnpm --dir apps/farm build",
    "typecheck": "tsc --noEmit && pnpm --dir apps/farm typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth-session": "node scripts/test-auth-session-e2e.ts",
    "test:rtc-farm": "node scripts/test-rtc-farm-acceptance.ts",
    "test:connector-outage": "node scripts/test-connector-outage-recovery.ts",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:node && pnpm run test:rtsp-supervisor && pnpm run test:rtsp-framing && pnpm run build",
    "sim:smoke": "node packages/sim-tools/src/cli.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "sim:seed": "node packages/sim-tools/src/seed-cli.ts",
    "sim:verify": "node packages/sim-tools/src/full-cli.ts",
    "sim:verify:rtsp": "node packages/sim-tools/src/rtsp-cli.ts",
    "test:node": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit tests/node/*.test.ts tests/unit/pause-authority-tooling.test.ts tests/unit/pause-authority-timeout.test.ts",
    "test:rtsp-supervisor": "node --test --test-concurrency=1 tools/rtsp-ingest/supervisor/*.test.ts",
    "test:rtsp-framing": "node --test tools/rtsp-ingest/integration/moving-fixture-input.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0",
    "prettier": "3.9.10",
    "effect": "4.1.2",
    "vitest": "5.1.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@open3dfarmmanager/farm-protocol": "workspace:*",
    "@open3dfarmmanager/shared": "workspace:*",
    "@open3dfarmmanager/sim-tools": "workspace:*",
    "postgres": "4.1.0"
  }
}
