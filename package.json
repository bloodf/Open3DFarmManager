{
  "name": "open3dfarmmanager",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.22.2 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @open3dfarmmanager/farm",
    "build": "npm run build -w @open3dfarmmanager/connector && npm run build -w @open3dfarmmanager/farm",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && npm run typecheck -w @open3dfarmmanager/farm",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:journey": "OPENFARM_JOURNEY=1 playwright test -c playwright.journey.config.ts",
    "test:e2e:auth-session": "node scripts/test-auth-session-e2e.ts",
    "test:rtc-farm": "node scripts/test-rtc-farm-acceptance.ts",
    "test:rtc-farm:all": "node scripts/test-rtc-farm-acceptance.ts --all",
    "test:connector-outage": "node scripts/test-connector-outage-recovery.ts",
    "test:sim-farm": "node scripts/test-sim-farm-acceptance.ts",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run test:node && node scripts/test-local-ci-regression.mjs && npm run test:postgres:security && npm run test:go && npm run test:rtsp-supervisor && npm run test:rtsp-framing && npm run build",
    "sim:smoke": "node packages/sim-tools/src/cli.ts",
    "lint": "prettier --check . && node apps/farm/app/assets/lint-hex-colours.mjs apps/farm/app/components apps/farm/app/assets",
    "format": "prettier --write .",
    "sim:seed": "node packages/sim-tools/src/seed-cli.ts",
    "sim:verify": "node packages/sim-tools/src/full-cli.ts",
    "sim:verify:rtsp": "node packages/sim-tools/src/rtsp-cli.ts",
    "test:node": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit tests/node/*.test.ts tests/unit/pause-authority-tooling.test.ts tests/unit/pause-authority-timeout.test.ts tests/helpers/kobralink-rtc/cdp-body.test.ts",
    "test:postgres": "node scripts/test-postgres.ts",
    "test:postgres:security": "POSTGRES_TEST_SUITES=test-postgres-auth.ts,test-postgres-pairing.ts,test-postgres-pause-authority.ts,test-postgres-pause-negotiation.ts node scripts/test-postgres.ts",
    "test:go": "sh -c 'if command -v go >/dev/null 2>&1; then cd tools/rtsp-ingest && go test -mod=readonly -tags=rtspfixture_network ./...; else echo \"SKIP: Go is unavailable; rtsp-ingest tests were not run\" >&2; fi'",
    "build:rtsp-ingest": "node scripts/build-rtsp-ingest.mjs",
    "desktop:check": "node scripts/desktop-check.ts",
    "test:rtsp-supervisor": "node --test --test-concurrency=1 tools/rtsp-ingest/supervisor/*.test.ts",
    "test:rtsp-framing": "node --test tools/rtsp-ingest/integration/moving-fixture-input.test.ts",
    "test:upgrade-rehearsal": "node --test --test-force-exit --test-timeout=1800000 tests/docker/upgrade-rehearsal.test.ts",
    "test:rtc-memory": "node scripts/test-rtc-memory.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@redocly/openapi-core": "2.83.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "effect": "4.1.4",
    "esbuild": "0.28.2",
    "node-datachannel": "0.33.6",
    "nuxt": "4.6.4",
    "openid-client": "6.9.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vue-tsc": "3.3.13",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@open3dfarmmanager/farm-protocol": "*",
    "@open3dfarmmanager/shared": "*",
    "@open3dfarmmanager/sim-tools": "*",
    "postgres": "4.1.1"
  }
}
