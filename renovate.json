{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Keep the qualified Node.js runtime and types on major 24 while allowing compatible updates.",
      "matchManagers": [
        "npm",
        "nvm",
        "dockerfile",
        "github-actions",
        "docker-compose"
      ],
      "matchDepNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Keep the Node.js 22 compatibility jobs on Node 22.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/sim.yml"
      ],
      "matchCurrentVersion": "/^22\\./",
      "allowedVersions": "<23"
    },
    {
      "description": "Keep PostgreSQL on major 17 until the persistent database volume has a qualified major upgrade path (Renovate #919).",
      "matchManagers": ["docker-compose"],
      "matchDepNames": ["postgres"],
      "matchFileNames": [
        "infra/app/docker-compose.yml",
        "infra/sandbox/compose.yml"
      ],
      "allowedVersions": "<18"
    },
    {
      "description": "Keep GitHub Actions runners on Ubuntu 24.04 because CI installs packages from noble-pgdg and jobs fail on Ubuntu 26 (Renovate #918).",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ubuntu"],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/sim.yml"
      ],
      "allowedVersions": "<25",
      "matchCurrentVersion": "/^24\\.04/"
    },
    {
      "description": "Keep root and farm TypeScript below 7 while vue-tsc uses the legacy compiler entry point and Volar requires TypeScript <7.",
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "matchFileNames": ["package.json", "apps/farm/package.json"],
      "allowedVersions": "<7"
    },
    {
      "description": "Vendored rtsp-ingest sources and the audited rtsp-ingest module graph are immutable and provenance-audited; updates are manual.",
      "matchFileNames": [
        "third_party/rtsp-ingest/**",
        "tools/rtsp-ingest/go.mod",
        "tools/rtsp-ingest/go.sum"
      ],
      "enabled": false
    }
  ]
}
