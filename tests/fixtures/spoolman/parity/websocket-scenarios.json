    "steps": [
      {
        "method": "POST",
        "path": "/api/v1/vendor",
        "body": {
          "name": "Spelling Probe"
        },
        "save": {
          "vendor": "id"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/v1/vendor/${vendor}"
      }
    ]
  },
  {
    "name": "handshake-unknown-paths",
    "listeners": [
      {
        "path": "/api/v1/vendor/abc"
      },
      {
        "path": "/api/v1/vendor/1/2"
      },
      {
        "path": "/api/v1/nothing"
      },
      {
        "path": "/api/v1/health"
      },
      {
        "path": "/api/v1/location"
      },
      {
        "path": "/api/v1/vendor/0"
      },
      {
        "path": "/api/v1/spool/-1"
      }
    ],
    "steps": [
      {
        "method": "GET",
        "path": "/api/v1/health"
      }
    ]
  }
]
