  {
    "name": "handshake-origin-and-host",
    "listeners": [
      {
        "path": "/api/v1/",
        "headers": {
          "Origin": "http://evil.example"
        }
      },
      {
        "path": "/api/v1/vendor",
        "headers": {
          "Origin": "http://${host}"
        }
      },
      {
        "path": "/api/v1/spool",
        "headers": {
          "Origin": "null"
        }
      },
      {
        "path": "/api/v1/filament",
        "headers": {
          "Origin": "not a url"
        }
      },
      {
        "path": "/api/v1/setting",
        "headers": {
          "Origin": "http://evil.example",
          "X-Forwarded-Host": "evil.example"
        }
      },
      {
        "path": "/api/v1/setting/currency",
        "headers": {
          "Origin": "http://evil.example",
          "X-Forwarded-Host": "evil.example, proxy.example"
        }
      }
    ],
    "steps": [
      {
        "method": "POST",
        "path": "/api/v1/vendor",
        "body": {
          "name": "Origin Probe"
        },
        "save": {
          "vendor": "id"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/v1/vendor/${vendor}"
      }
    ]
  },
  {
