  {
    "name": "client-ping-reply",
    "settleMs": 1800,
    "listeners": [
      {
        "path": "/api/v1/",
        "send": "ping"
      },
      {
        "path": "/api/v1/vendor",
        "send": ""
      },
      {
        "path": "/api/v1/setting/currency",
        "send": "hello"
      }
    ],
    "steps": [
      {
        "method": "GET",
        "path": "/api/v1/health"
      }
    ]
  },
