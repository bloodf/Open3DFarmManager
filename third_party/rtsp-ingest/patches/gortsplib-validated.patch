+// Limits bounds the existing SDP scanner and its structural collections.
+type Limits struct {
+	MaxBodyBytes         int
+	MaxLineBytes         int
+	MaxLines             int
+	MaxMediaDescriptions int
+	MaxFormatsPerMedia   int
+	MaxAttributes        int
+}
+
+// Validate rejects invalid limits before input processing.
+func (l Limits) Validate() error {
+	if l.MaxBodyBytes <= 0 || l.MaxBodyBytes > 128*1024 {
+		return fmt.Errorf("invalid SDP body limit")
+	}
+	for _, n := range []int{l.MaxLineBytes, l.MaxLines, l.MaxMediaDescriptions, l.MaxFormatsPerMedia, l.MaxAttributes} {
+		if n <= 0 || n > l.MaxBodyBytes {
+			return fmt.Errorf("invalid SDP structural limit")
+		}
+	}
+	if l.MaxMediaDescriptions > l.MaxLines || l.MaxAttributes > l.MaxLines {
+		return fmt.Errorf("invalid SDP line-derived limit")
+	}
+	return nil
+}
+
+type parseBudget struct {
+	limits     Limits
+	lines      int
+	attributes int
+	ancillary  int
+}
+
+func (b *parseBudget) chargeAncillary() error {
+	if b == nil {
+		return nil
+	}
+	if b.ancillary >= b.limits.MaxLines {
+		return fmt.Errorf("SDP ancillary limit exceeded")
+	}
+	b.ancillary++
+	return nil
+}
 
